{
  "appId": "gen.yoga.app",
  "appName": "GenYoga",
  "webDir": "www",
  "backgroundColor": "#26160c",
  "server": {
    "allowNavigation": [
      "*.youtube.com",
      "*.youtube-nocookie.com",
      "*.googlevideo.com",
      "*.ytimg.com",
      "genyoga.studio",
      "*.genyoga.studio",
      "*.supabase.co",
      "checkout.stripe.com",
      "billing.stripe.com",
      "cdn.jsdelivr.net"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#26160c",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#26160c",
      "overlaysWebView": false
    },
    "Browser": {},
    "App": {},
    "Network": {}
  }
}
