{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=jkjifmrrlyncuwpjhxvk&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "timeout": {
          "startup": 90000
        }
      },
      "stripe": {
        "type": "remote",
        "url": "https://mcp.stripe.com/"
      }
    }
  }
}
