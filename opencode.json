{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=jkjifmrrlyncuwpjhxvk&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
      },
      "github": {
        "type": "local",
        "command": [
          "C:\\Users\\48150437Y\\.config\\opencode\\bin\\github-mcp-server.exe",
          "stdio",
          "--toolsets",
          "repos,issues,pull_requests,actions"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        },
        "timeout": {
          "startup": 60000
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "timeout": {
          "startup": 90000
        }
      },
      "stripe": {
        "type": "remote",
        "url": "https://mcp.stripe.com/"
      }
    }
  }
}
