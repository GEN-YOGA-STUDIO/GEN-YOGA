{
  "name": "gen-yoga-app",
  "version": "9.14.0",
  "description": "Sitio web de GEN Yoga y verificaciones de calidad para la versión 9.14",
  "scripts": {
    "test": "npm run check:web && npm run check:teachers && npm run check:calendar && npm run check:overlaps && npm run check:stripe && npm run check:cursor",
    "check:web": "node scripts/check-web-quality.mjs",
    "check:teachers": "node scripts/check-teacher-profiles.mjs",
    "check:calendar": "node scripts/check-public-calendar.mjs",
    "check:overlaps": "node scripts/check-schedule-overlaps.mjs",
    "check:stripe": "node scripts/check-stripe-production.mjs",
    "check:cursor": "node scripts/check-cursor-visibility.mjs",
    "build:css": "tailwindcss -i ./tailwind-input.css -o ./tailwind-compiled.css --minify",
    "build:cert": "node scripts/build-certification.mjs",
    "bump": "node scripts/bump-version.mjs",
    "deploy:web": "node scripts/deploy-web.mjs",
    "update:apps": "node scripts/update-apps.mjs",
    "deploy:apps": "node scripts/update-apps.mjs",
    "dev": "npx -y live-server --port=5500"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
